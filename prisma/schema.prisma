generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model Profile {
  id String @id
  name String
  description String
  title String
  location String
  education String
  languages String
  links ProfessionalLink[]
  skills Skill[]
  experience Experience[]
  projects Project[]
}
model ProfessionalLink {
  id String @id
  label String
  url String
  order Int
  profileId String
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, order])
}
model Skill {
  id String @id
  name String
  order Int
  profileId String
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, order])
}
model Experience {
  id String @id
  company String
  position String
  projectName String?
  period String @default("Период не указан")
  startDate DateTime?
  endDate DateTime?
  achievements String
  order Int
  profileId String
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, order])
}
model Project {
  id String @id
  name String
  description String
  technologies String
  website String?
  url String
  order Int
  profileId String
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, order])
}
